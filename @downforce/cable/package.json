    "peerDependencies": {
        "@types/node": "catalog:"
    },
    "devDependencies": {
        "@downforce/tsconfig": "workspace:*",
        "@types/node": "catalog:",
        "typescript": "catalog:"
    },
    "author": "Daniele Orlando",
    "license": "MIT",
    "description": "Awesome TypeScript and JavaScript configuration library for NodeJS",
    "keywords": [
        "TypeScript",
        "JavaScript",
        "Configuration"
    ],
    "homepage": "https://github.com/downforcetech/downforce.js",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/downforcetech/downforce.js.git"
    },
    "bugs": {
        "url": "https://github.com/downforcetech/downforce.js/issues"
    }
