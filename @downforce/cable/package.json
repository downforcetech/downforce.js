{
    "name": "@downforce/cable",
    "version": "1.0.4",
    "type": "module",
    "sideEffects": false,
    "files": [
        "./LICENSE.txt",
        "./esm/",
        "./ts/"
    ],
    "exports": {
        ".": "./esm/all.js",
        "./*": "./esm/*.js"
    },
    "scripts": {
        "prepack": "./bin/clean.sh && ./bin/build.sh && ./bin/test.sh",
        "preversion": "./bin/build.sh && ./bin/test.sh"
    },
    "dependencies": {
        "@downforce/std": "workspace:*"
    },
    "optionalDependencies": {
        "smol-toml": "1.6",
        "yaml": "2.8"
