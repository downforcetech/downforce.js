{
    "name": "@downforce/reactx",
    "version": "1.2.12",
    "type": "module",
    "sideEffects": false,
    "files": [
        "./LICENSE.txt",
        "./esm/",
        "./ts/"
    ],
    "exports": {
        "./*.css": "./ts/*.css",
        "./*": "./esm/*.js"
    },
    "scripts": {
        "prepack": "./bin/clean.sh && ./bin/build.sh && ./bin/test.sh",
        "preversion": "./bin/build.sh && ./bin/test.sh"
    },
    "peerDependencies": {
        "@downforce/react": "1",
        "@downforce/std": "1",
        "@downforce/std.css": "1",
        "@downforce/web": "1",
        "@downforce/webx": "1",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:"
    },
    "devDependencies": {
        "@downforce/react": "workspace:*",
        "@downforce/std": "workspace:*",
        "@downforce/std.css": "workspace:*",
        "@downforce/tsconfig": "workspace:*",
        "@downforce/web": "workspace:*",
        "@downforce/webx": "workspace:*",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "typescript": "catalog:"
    },
    "author": "Daniele Orlando",
    "license": "MIT",
    "description": "Awesome React UI Widgets",
    "keywords": [
        "React",
        "UI"
    ],
    "homepage": "https://github.com/downforcetech/downforce.js",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/downforcetech/downforce.js.git"
    },
    "bugs": {
        "url": "https://github.com/downforcetech/downforce.js/issues"
    }
}
