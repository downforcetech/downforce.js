{
    "tags": [
      "type:lib"
    ],
    "implicitDependencies": [
        "repository",
        "@downforce/react",
        "@downforce/std",
        "@downforce/std.css",
        "@downforce/tsconfig",
        "@downforce/web",
        "@downforce/webx"
    ],
    "targets": {
        "init": {
            "dependsOn": [
                "repository:init",
                "^build"
            ],
            "executor": "nx:run-commands",
            "options": {
                "cwd": "{projectRoot}",
                "command": "./bin/build.sh"
            }
        },
        "build": {
            "dependsOn": [
                "^build",
                "init"
            ],
            "executor": "nx:run-commands",
            "options": {
                "cwd": "{projectRoot}",
                "command": "./bin/build.sh"
            }
        },
        "test": {
            "dependsOn": [
                "build"
            ],
            "executor": "nx:run-commands",
            "options": {
                "cwd": "{projectRoot}",
                "command": "./bin/test.sh"
            }
        }
    }
}
