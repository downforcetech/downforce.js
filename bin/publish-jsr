#!/usr/bin/env sh

## USAGE #######################################################################
##
##   publish-jsr <package-dir> ...
##
## EXAMPLE
##
##   publish-jsr ./@downforce/*
##
################################################################################

set -eu

case "$(dirname "$0")" in
    /*|./*) Dir=$(cd "$(dirname "$0")" && pwd);;
    *) Dir=$(cd "$PWD/$(dirname "$0")" && pwd);;
esac

RepositoryDir=$(cd "$Dir/.." && pwd)

export PATH="$RepositoryDir/bin:$PATH"

usage() {
    echo
    echo "USAGE: $(basename "$0") <package-dir> ..."
    echo
}

if test $# -lt 1; then
    usage
    exit 1
fi

: ${JsrPublishArgs:=}

for pkg; do
    if ! test -e "$pkg/jsr.jsonc"; then
        echo "skipping invalid package '$pkg'."
        continue
    fi

    (
        case "$pkg" in
            /*|./*) cd "$pkg";;
            *) cd "$PWD/$pkg";;
        esac

        set -- $JsrPublishArgs

        until deno publish --sloppy-imports "$@"; do
            printf -- 'Press Enter to retry'
            read answer
        done
    )
done
